      "left": 20,
      "attrs": {}
    },
    {
      "type": "wokwi-led-ring",
      "id": "zones",
      "top": -115,
      "left": 240,
      "attrs": { "pixels": "16" }
    },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": -115,
      "left": -15,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": -90,
      "left": -150,
      "attrs": { "volume": "0.2" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_threat",
      "top": 55,
      "left": -150,
      "attrs": { "color": "red", "label": "THREAT TRIGGER" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_reset",
      "top": 145,
      "left": -150,
      "attrs": { "color": "green", "label": "ALL-CLEAR RESET" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "mic_pot",
      "top": 245,
      "left": -145,
      "attrs": { "label": "ACOUSTIC dB" }
    }
