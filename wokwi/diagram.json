  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:3V3", "oled:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "oled:GND", "black", [ "v0" ] ],
    [ "esp:22", "oled:SCL", "yellow", [ "v0" ] ],
    [ "esp:21", "oled:SDA", "blue", [ "v0" ] ],

    [ "esp:5V", "zones:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "zones:GND", "black", [ "v0" ] ],
    [ "esp:4", "zones:DIN", "green", [ "v0" ] ],

    [ "esp:25", "buzzer:2", "purple", [ "v0" ] ],
    [ "esp:GND.2", "buzzer:1", "black", [ "v0" ] ],

    [ "esp:26", "btn_threat:1.l", "red", [ "v0" ] ],
    [ "esp:GND.2", "btn_threat:2.l", "black", [ "v0" ] ],

    [ "esp:27", "btn_reset:1.l", "green", [ "v0" ] ],
    [ "esp:GND.2", "btn_reset:2.l", "black", [ "v0" ] ],

    [ "esp:3V3", "mic_pot:VCC", "red", [ "v0" ] ],
    [ "esp:GND.2", "mic_pot:GND", "black", [ "v0" ] ],
    [ "esp:34", "mic_pot:SIG", "gold", [ "v0" ] ]
